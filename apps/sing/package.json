{
    "name": "sing",
    "private": true,
    "sideEffects": false,
    "type": "module",
    "scripts": {
        "build": "remix vite:build",
        "dev": "remix vite:dev",
        "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
        "typecheck": "tsc",
        "i18n:extract": "formatjs extract 'app/**/*.ts*' --ignore='**/*.d.ts' --out-file app/translations/extracted-messages/en.json && node scripts/extract-translations.js && prettier --write app/translations/extracted-messages",
        "i18n:compile": "formatjs compile-folder app/translations/extracted-messages app/translations/compiled-messages"
    },
    "dependencies": {
        "@remix-run/react": "catalog:",
        "@repo/api": "workspace:*",
        "@repo/db": "workspace:*",
        "@repo/ui": "workspace:*",
        "@repo/utils": "workspace:*",
        "@stripe/stripe-js": "^9.2.0",
        "@trpc/server": "catalog:",
        "@vercel/remix": "catalog:",
        "accept-language-parser": "^1.5.0",
        "lucide-react": "^1.8.0",
        "react": "catalog:",
        "react-dom": "catalog:",
        "react-intl": "^7.1.14",
        "vaul": "^1.1.2",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@formatjs/cli": "^6.14.1",
        "@remix-run/dev": "catalog:",
        "@remix-run/node": "catalog:",
        "@repo/config-eslint": "workspace:*",
        "@repo/config-tailwind": "workspace:*",
        "@repo/config-typescript": "workspace:*",
        "@tailwindcss/vite": "catalog:",
        "@types/accept-language-parser": "^1.5.8",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "eslint": "catalog:",
        "tailwindcss": "catalog:",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vite-tsconfig-paths": "catalog:"
    },
    "engines": {
        "node": ">=20.0.0"
    }
}
