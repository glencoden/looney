{
    "extends": "@repo/config-typescript/react-library.json",
    "compilerOptions": {
        "baseUrl": ".",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "allowJs": true,
        "forceConsistentCasingInFileNames": true,
        "noEmit": true,
        "types": ["vite/client", "node"],
        "paths": {
            "~/*": ["./src/*"]
        }
    },
    "include": ["src/**/*.ts", "src/**/*.tsx", "api/**/*.ts", "vite.config.ts"]
}
