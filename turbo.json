{
    "$schema": "https://turbo.build/schema.json",
    "ui": "tui",
    "globalEnv": [
        "NODE_ENV",
        "NEXT_PHASE",
        "VERCEL_URL",
        "PORT",
        "DATABASE_URL",
        "HOST_SING",
        "SING_RESET_ID",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "GOOGLE_CLIENT_EMAIL",
        "GOOGLE_PRIVATE_KEY_BASE64",
        "GOOGLE_CALENDAR_ID",
        "GLEN_CALENDAR_PROJECT_NUMBER",
        "CALENDAR_SCOPES",
        "OPENAI_API_KEY",
        "STRIPE_SECRET_KEY",
        "TIP_STRIPE_PRICE",
        "VITE_STRIPE_PUBLISHABLE_KEY"
    ],
    "envMode": "loose",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**", "build/**", "api/**"]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "lint": {
            "dependsOn": ["^lint"]
        },
        "typecheck": {
            "dependsOn": ["^typecheck"]
        }
    }
}
